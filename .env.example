# Cola de trabajos
REDIS_URL=redis://redis:6379/0

# Nombre de la lista de Redis que `api` publica y `worker` consume. Los dos procesos la
# leen de esta misma variable: si se cambia aquí, cambia para los dos.
NOMBRE_COLA=procesamiento

# Base de datos (declarada para corresponder con el Nivel 2 del ADR-0002;
# todavía sin esquema ni migraciones, ningún módulo la usa aún)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omr
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/omr

# Almacén de hojas escaneadas. Apunta al volumen `almacen_imagenes`, montado en `api`
# y en `worker` para que ambos vean el mismo archivo. Provisional: la decisión de
# almacenamiento definitiva es el ADR de persistencia pendiente (riesgo R-06).
RUTA_ALMACEN=/app/almacen_imagenes

# Bitácora de recepción (ADR-0006). Vive dentro del volumen del almacén, porque las dos
# cosas que relaciona son el archivo guardado y el trabajo encolado. Solo la escribe `api`:
# `worker` no la lee. Si se cambia RUTA_ALMACEN, hay que cambiar esta ruta con ella.
RUTA_BITACORA=/app/almacen_imagenes/bitacora-de-recepcion.jsonl

# Puertos publicados en el host
BACKEND_PORT=8000
FRONTEND_PORT=8080

# CORS: origen desde el que el frontend llama al backend
ALLOWED_ORIGIN=http://localhost:8080

# Proveedor de LLM que propone distractores diagnósticos (RF-11, ADR-0013). Es opcional: sin
# clave, la ruta /distractores responde 503 y el resto del sistema funciona igual. La clave se
# escribe solo en el `.env` local, que git ignora, y nunca en este archivo (RNF-11).
LLM_URL_BASE=https://api.groq.com/openai/v1
LLM_MODELO=openai/gpt-oss-120b
LLM_API_KEY=
