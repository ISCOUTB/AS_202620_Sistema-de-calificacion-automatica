# Variables del servicio `sistema` en Dokploy → Environment (una por línea). Dokploy escribe con
# ellas deploy/.env en el servidor al desplegar; compose.lab.yaml solo las referencia con
# ${VARIABLE}. Para probar en un computador: copia este archivo a deploy/.env, que git ignora.
#
# Nada de este archivo es secreto. La única variable sensible, LLM_API_KEY, va vacía aquí y su
# valor real se escribe solo en el panel (RNF-11).

# Origen del sitio que llama a la API (CORS admite uno solo): esquema y host, sin ruta ni barra
# final. En el servidor es el del sitio; en la prueba local, http://127.0.0.1:8080.
ALLOWED_ORIGIN=https://calificacion.iscoutb.dev

# Proveedor de LLM para los distractores (ADR-0013). Sin clave, POST /distractores responde 503 y
# el resto de la API funciona igual.
LLM_API_KEY=

# Opcionales: compose.lab.yaml ya trae estos valores por omisión. Solo hace falta escribirlas en
# el panel para cambiarlas.
# NOMBRE_COLA=procesamiento
# LLM_URL_BASE=https://api.groq.com/openai/v1
# LLM_MODELO=openai/gpt-oss-120b
# LLM_SOLICITUDES_POR_MINUTO=6
# LLM_SOLICITUDES_POR_DIA=150

# Solo para la prueba local con compose.local-override.yaml: puertos del computador donde se
# publican la API y el sitio. En el servidor no se usan.
# PUERTO_LOCAL_API=8000
# PUERTO_LOCAL_SITIO=8080
